# Copy this file to .env and fill in your SANDBOX values. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Any long random text. Keeps shopper sessions valid across restarts.
SESSION_SECRET=
# Optional. Set on a host if PayPal's return link points to the wrong address.
PUBLIC_BASE_URL=
# Set to true when hosted on https (e.g. Render).
HTTPS_ONLY=
# AI provider (used from Day 3)
GEMINI_API_KEY=
GROQ_API_KEY=
